{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/watchdog",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sync-entry-log",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/purge-email-archive",
      "schedule": "7 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/block-pricing-guests": false,
      "codex/admin-daily-refinements": false,
      "codex/fix-audit-braces": false,
      "codex/required-phone-members": false,
      "codex/calendar-blocking-evening": false,
      "codex/blocking-periods-legacy-cleanup": false,
      "codex/compact-blocking-history": false
    }
  },
  "regions": ["cdg1"]
}
