{
  "name": "gym-plzen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,css,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,css,json,md,yml,yaml}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "set-admin": "tsx scripts/set-admin.ts",
    "rebrand:navi": "tsx scripts/rebrand-navi.ts",
    "set-promo": "tsx scripts/set-promo.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-force-exit --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
