    "@types/react-dom": "^19.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.0",
    "prettier": "^3.5.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
