# ─────────────────────────────────────────────────────────────────────────────
# gym-plzen — environment variables
#
# Copy this file to `.env.local` and fill in the values. See NEEDED.md for a
# step-by-step guide on where to obtain each secret. Variables prefixed with
# NEXT_PUBLIC_ are exposed to the browser — never put secrets there.
# ─────────────────────────────────────────────────────────────────────────────

# App --------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Comma-separated locales; first is the default.
NEXT_PUBLIC_DEFAULT_LOCALE="cs"

# Database (Supabase Postgres) -------------------------------------------------
# Pooled connection (used by the app at runtime — port 6543, pgbouncer).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
# Direct connection (used by drizzle-kit for migrations — port 5432).
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Supabase (realtime calendar + storage) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Storage bucket that holds CMS media (images, files).
SUPABASE_STORAGE_BUCKET="cms-media"

# Better Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers (optional — enable the ones you want) ------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Stripe (payments & subscriptions) -------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Resend (transactional email) ------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Gym Plzeň <noreply@example.com>"

# WhatsApp Business Cloud API -------------------------------------------------
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Token you invent; must match what you enter in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=""
# App secret used to verify webhook signatures.
WHATSAPP_APP_SECRET=""

# Nuki Web API (smart lock) ---------------------------------------------------
NUKI_API_TOKEN=""
NUKI_SMARTLOCK_ID=""
# Secret you configure on the Nuki webhook to verify inbound calls.
NUKI_WEBHOOK_SECRET=""

# GoSMS (optional SMS fallback) -----------------------------------------------
GOSMS_CLIENT_ID=""
GOSMS_CLIENT_SECRET=""
GOSMS_CHANNEL=""

# Sentry (error & uptime monitoring) ------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Operational alerts (WhatsApp group for the operator + developer) ------------
# WhatsApp phone numbers (E.164) that receive system failure alerts,
# comma-separated, e.g. "+420777123456,+420777654321".
ALERT_WHATSAPP_RECIPIENTS=""

# Cron / background jobs -------------------------------------------------------
# Shared secret guarding /api/cron/* routes. Generate with: openssl rand -hex 32
CRON_SECRET=""
