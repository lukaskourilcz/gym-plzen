# ─────────────────────────────────────────────────────────────────────────────
# gym-plzen — environment variables
#
# Copy this file to `.env.local` and fill in the values. See NEEDED.md for a
# step-by-step guide on where to obtain each secret. Variables prefixed with
# NEXT_PUBLIC_ are exposed to the browser — never put secrets there.
# ─────────────────────────────────────────────────────────────────────────────

# App --------------------------------------------------------------------------
# Drives every absolute customer-facing URL: e-mail links and logo, the
# calendar event identity. Moving domain is a change here plus a redeploy.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Analytics. Leave empty and nothing is loaded and no consent category is
# offered, which is correct until the operator supplies real accounts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
# Meta domain verification: the `content` value of the meta tag Meta shows under
# Business Settings -> Brand safety -> Domains -> navigym.cz. Rendered into <head>
# by the root layout; unset renders nothing. (DNS for navigym.cz is at the
# registrar, so the tag is the method this deployment can satisfy by itself.)
META_DOMAIN_VERIFICATION=""
# Search Console HTML verification, including redirected legacy URL properties.
# Public verification codes, comma-separated when several domains use distinct
# tokens. Not API keys; keep them after the site migration.
GOOGLE_SITE_VERIFICATION=""
# Comma-separated locales; first is the default.
NEXT_PUBLIC_DEFAULT_LOCALE="cs"

# Database (Supabase Postgres) -------------------------------------------------
# Transaction pooler (app runtime — port 6543, pgbouncer → prepare:false).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Session pooler (drizzle-kit migrations — port 5432).
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase JS client (realtime calendar + storage) ----------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# New key model: publishable (public, browser) + secret (server, bypasses RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
# Server/API handler aliases used by @supabase/server.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_JWKS_URL="https://<ref>.supabase.co/auth/v1/.well-known/jwks.json"
# Optional: keeps registration and password-reset templates edited in /admin/emails
# synchronised with hosted Supabase Auth. Create a scoped token in Supabase Account > Access Tokens.
SUPABASE_MANAGEMENT_API_TOKEN=""
# Legacy keys still accepted as fallbacks if you use an older project:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""
# Storage bucket that holds CMS media (images, files).
SUPABASE_STORAGE_BUCKET="cms-media"

# Authentication ---------------------------------------------------------------
# Handled by Supabase Auth (see the Supabase block above). No secrets here —
# email/password and OAuth providers are configured in the Supabase dashboard.
# List only providers that are enabled and tested in Supabase (google,apple,azure).
NEXT_PUBLIC_OAUTH_PROVIDERS=""
# Optional local preview accounts. This is ignored in production even if set.
DEMO_AUTH_ENABLED="false"
DEMO_AUTH_SECRET="generate-at-least-32-random-characters"
# Optional non-production calendar fixture for visual demos without a database.
BOOKING_PREVIEW_FIXTURE="false"

# Comgate REST API 2.0 (hosted redirect, server-only credentials) ---------------
# Merchant is the shop connection ID, secret its communication password.
# Leave empty until activated. See docs/COMGATE_SETUP.md.
COMGATE_MERCHANT_ID=""
COMGATE_SECRET=""
COMGATE_TEST_MODE="true"
# Leave empty. The integration tests point this at a local stand-in gateway.
COMGATE_API_URL=""

# Google Maps -----------------------------------------------------------------
# Paste the API key VALUE from Google Cloud Credentials (normally starts AIza),
# not the credential name, key ID, Map ID or placeholder API_KEY. Restrict it to
# browser referrers and Maps JavaScript API (that one API is enough : the gym's
# coordinates are in the source, so no Geocoding or Places).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Map ID from Google Maps Platform - Map Management (type JavaScript, vector).
# BOTH this and the key are required: the branded map uses an advanced marker,
# which Google only renders for a real Map ID. With either one missing the site
# keeps the standard embedded map, rather than loading a script that can only
# fail and log an authentication error in every visitor's console.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# Resend (transactional email) ------------------------------------------------
RESEND_API_KEY=""
# The domain must be verified in Resend. The current production sender is:
RESEND_FROM_EMAIL="NAVI Private Gym <noreply@navigym.cz>"

# WhatsApp Business Cloud API -------------------------------------------------
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Token you invent; must match what you enter in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=""
# App secret used to verify webhook signatures.
WHATSAPP_APP_SECRET=""

# Zernio (WhatsApp gateway, access-code delivery) -----------------------------
# Setup in MANUAL_STEPS.md §4. With both set, members who ticked "Také přes
# WhatsApp" in their profile (and saved a phone) get the PIN there too, an hour
# before the booking. Without them nothing is sent over WhatsApp; the e-mail is
# the mandatory channel either way.
ZERNIO_API_KEY=""
ZERNIO_ACCOUNT_ID=""

# Nuki Web API (smart lock) ---------------------------------------------------
NUKI_API_TOKEN=""
NUKI_SMARTLOCK_ID=""
# Secret you configure on the Nuki webhook to verify inbound calls.
NUKI_WEBHOOK_SECRET=""

# GoSMS (optional SMS fallback) -----------------------------------------------
GOSMS_CLIENT_ID=""
GOSMS_CLIENT_SECRET=""
GOSMS_CHANNEL=""

# Sentry (error & uptime monitoring) ------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Operational alerts (WhatsApp group for the operator + developer) ------------
# WhatsApp phone numbers (E.164) that receive system failure alerts,
# comma-separated, e.g. "+420777123456,+420777654321".
ALERT_WHATSAPP_RECIPIENTS=""

# Cron / background jobs -------------------------------------------------------
# Shared secret guarding /api/cron/* routes. Generate with: openssl rand -hex 32
CRON_SECRET=""
# UptimeRobot heartbeat (dead-man's switch). The watchdog cron pings this on
# success; UptimeRobot alerts when it stops hearing from us within the grace
# period. Get the URL from an UptimeRobot Heartbeat monitor.
UPTIMEROBOT_HEARTBEAT_URL=""

# Server-only AES-256 key, 32 random bytes encoded as 64 hex characters. Never NEXT_PUBLIC.
ACCESS_CODE_ENCRYPTION_KEY=
